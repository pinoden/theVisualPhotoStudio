# Settings files with keys never go into git. The site's own are covered by web/.gitignore.
.env

# Editor, tool and system files. Agent definitions in .claude/agents are shared; the rest of .claude is personal.
.idea/
.claude/*
!.claude/agents/
.DS_Store

# The old website's photos and their manifest, for scripts/import-old-site-photos.ts: their file names hold clients' names.
/old-site-photos/
