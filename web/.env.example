# Copy to .env.local and fill in. Nothing here is needed for local development:
# without these the app uses an embedded database, a pretend card processor,
# and shows emails at /dev/outbox instead of sending them.

# PostgreSQL connection string. Required in production.
# Leave unset locally to use PGlite stored in web/.data.
DATABASE_URL=

# Public address of the site, used for links in emails.
SITE_URL=http://localhost:3000

# Who is an owner (sees /admin). Comma-separated email addresses. Owners sign
# in with an emailed code like everyone else. Removing an address takes the
# role away at once. Locally, put your own address here to see the admin.
OWNER_EMAILS=
# Where refund notices and messages from the contact page are sent. Defaults to
# the first address in OWNER_EMAILS. With neither set, the contact form refuses messages.
OWNER_NOTIFY_EMAIL=

# Square (https://developer.squareup.com/apps). All three are required to
# take real payments. Which of Square's accounts they are for is read from the
# application id (a sandbox one begins with "sandbox-"); SQUARE_ENVIRONMENT,
# "sandbox" or "production", may be left empty, and when set must agree, or
# card payments stay off. With sandbox keys here the site shows Square's real
# card form and moves no money. Each booking records whether it was made in
# test mode (src/server/test-mode.ts): once live keys are set, the site refuses
# to open a database that holds test mode's bookings, until
# `npm run db:clear-test-mode` has removed them (run it once without `-- --yes`
# to see what it would remove; it removes nothing else). No server in test mode
# (a demo, staging, an old deployment) may use the live database.
# `npm run check:square` tests sandbox keys kept in .env.square-sandbox.
SQUARE_ENVIRONMENT=
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Set to "mock" to run a production build with the pretend card processor
# (for demos and staging only; no money moves).
PAYMENTS_MODE=

# Email delivery through Resend (https://resend.com). Both are required in
# production: without them no email is sent, including sign-in codes.
# EMAIL_FROM must be an address on a domain verified with Resend,
# for example: The Visuals Photo Studio <bookings@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Secret for the scheduler that calls GET /api/cron/tick every few minutes
# with the header "Authorization: Bearer <CRON_SECRET>". Required in
# production. That call completes visits, sends loyalty codes, retries
# refunds and delivers queued email.
CRON_SECRET=
